{
  "name": "searchkit-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/searchkit/searchkit.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "turbo run test --filter='./packages/*'",
    "build": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev --parallel",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait && node e2e/seed.mjs",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "test:e2e": "pnpm --filter @searchkit/e2e test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --filter='./packages/*'",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@types/jest": "^26.0.15",
    "@types/node": "^18.0.0",
    "@types/react": "^18.2.28",
    "eslint-config-custom": "workspace:*",
    "eslint-plugin-prettier": "5.0.0",
    "husky": "9.1.7",
    "prettier": "^2.8.8",
    "turbo": "2.11.11",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.11 || ^24 || >=26"
  }
}
