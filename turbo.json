{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": ["ES_HOST", "ES_API_KEY", "ES_USERNAME", "ES_PASSWORD", "GITHUB_TOKEN"],
  "pipeline": {
    "test": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "searchkit#typecheck": {
      "dependsOn": ["build", "@searchkit/api#build"],
      "outputs": []
    },
    "dev": {
      "cache": false
    }
  }
}
