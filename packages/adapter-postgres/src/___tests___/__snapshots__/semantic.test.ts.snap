),
text_ranked AS (
  SELECT t."id" AS _id, row_number() OVER (ORDER BY ts_rank_cd(t."search_vector", q.tsq) DESC, t."id" ASC) AS _r
  FROM "products" t CROSS JOIN q
  WHERE t."search_vector" @@ q.tsq
),
ranked AS (
  SELECT _id, sum(1.0 / (60 + _r)) AS _rank
  FROM (
    SELECT _id, _r FROM text_ranked
    UNION ALL
    SELECT _id, row_number() OVER (ORDER BY _distance ASC, _id ASC) AS _r FROM nearest
  ) u
  GROUP BY _id
),
base AS (
  SELECT t."id", t."name", coalesce(r._rank, 0)::float8 AS _score
  FROM "products" t JOIN ranked r ON t."id" = r._id
),
hits AS (
  SELECT "id", "name", _score, row_number() OVER (ORDER BY _score DESC, "id" ASC) AS _rn
  FROM base
  ORDER BY _score DESC, "id" ASC
  LIMIT $5 OFFSET $6
),
total AS (SELECT count(*) AS n FROM base)
SELECT
  (SELECT coalesce(json_agg(h ORDER BY h._rn), '[]'::json) FROM hits h) AS hits,
  (SELECT n FROM total) AS total"
`;

