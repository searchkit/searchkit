// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`highlighting and snippets runs ts_headline for highlight and snippet attributes on the page of hits 1`] = `
"WITH q AS (SELECT websearch_to_tsquery($1::regconfig, $2) AS tsq),
base AS (
  SELECT t."id", t."name", t."brand", t."categories", t."description", ts_rank_cd(t."search_vector", q.tsq) AS _score
  FROM "products" t CROSS JOIN q
  WHERE t."search_vector" @@ q.tsq
),
hits AS (
  SELECT "id", "name", "brand", "categories", "description", _score, row_number() OVER (ORDER BY _score DESC, "id" ASC) AS _rn
  FROM base
  ORDER BY _score DESC, "id" ASC
  LIMIT $3 OFFSET $4
),
total AS (SELECT count(*) AS n FROM base)
SELECT
  (SELECT coalesce(json_agg(h ORDER BY h._rn), '[]'::json) FROM (SELECT hits.*, json_build_object($6::text, ts_headline($1::regconfig, coalesce(hits."name"::text, ''), q.tsq, $5), $7::text, (SELECT array_agg(ts_headline($1::regconfig, coalesce(_e.value::text, ''), q.tsq, $5) ORDER BY _e.n) FROM unnest(hits."categories") WITH ORDINALITY AS _e(value, n))) AS _highlight, json_build_object($10::text, ts_headline($1::regconfig, coalesce(hits."description"::text, ''), q.tsq, $8), $11::text, ts_headline($1::regconfig, coalesce(hits."brand"::text, ''), q.tsq, $9)) AS _snippet FROM hits CROSS JOIN q) h) AS hits,
  (SELECT n FROM total) AS total"
`;
