# Optional: point the example at your own Elasticsearch.
# Without these the public demo cluster is used.
# ES_HOST=http://localhost:9200
# ES_API_KEY=
# ES_USERNAME=
# ES_PASSWORD=

# Optional: search Postgres instead (see e2e/seed-postgres.mjs for the `products` table).
# SEARCH_ADAPTER=postgres
# DATABASE_URL=postgres://postgres:searchkit@localhost:5432/postgres
